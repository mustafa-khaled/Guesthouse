# ============================================
# Docker Compose Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# General
# ============================================
NODE_ENV=production

# ============================================
# MongoDB (Docker)
# ============================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-this-secure-password
MONGO_APP_USERNAME=guesthouse_app
MONGO_APP_PASSWORD=change-this-app-user-password

# ============================================
# Redis (Docker)
# ============================================
REDIS_PASSWORD=change-this-redis-password

# ============================================
# Authentication
# ============================================
JWT_ACCESS_SECRET=your-access-secret-at-least-32-characters-long-change-me
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters-long-change-me

# ============================================
# URLs
# ============================================
# Local dev: frontend on 3001 (pnpm dev). Docker/production: frontend on 3000.
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================
# Google OAuth - Optional
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# ============================================
# Audit Log
# ============================================
AUDIT_LOG_RETENTION_DAYS=90

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# Email (SMTP) - Optional
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_EMAIL_FROM=

# ============================================
# Stripe Payments - Optional
# ============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# Cloudinary (Image Uploads) - Optional
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
