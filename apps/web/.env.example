# ============================================
# Frontend Environment Variables
# ============================================
# Copy to .env.local for local development (pnpm dev runs on port 3001)

# Server-side backend URL (used by Next.js API routes / BFF proxy)
BACKEND_URL=http://localhost:5000

# Client-side public variables (inlined at build time in production Docker images)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: Cloudinary image optimization in Next.js
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
